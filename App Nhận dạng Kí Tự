MODEL_PATH = Path(__file__).parent / "model.keras"
LABELS     = list("ABCDEFGHIJKLMNOPQRSTUVWXYZ")

def fix_image(img_flat):
    img = img_flat.reshape(28, 28)
    img = np.rot90(img, k=3)
    img = np.fliplr(img)
    return img.reshape(784)

def train_and_save():
    import pandas as pd, kagglehub
    from keras.models import Sequential
    from keras.layers import Dense, Dropout, BatchNormalization
    from keras.utils import to_categorical
    from keras.callbacks import EarlyStopping, ReduceLROnPlateau

    with st.spinner("⏳ Đang tải dataset EMNIST (lần đầu ~vài phút)..."):
        path = kagglehub.dataset_download("crawford/emnist")
    with st.spinner("⏳ Đang đọc CSV..."):
        tr = pd.read_csv(f"{path}/emnist-letters-train.csv", header=None)
        te = pd.read_csv(f"{path}/emnist-letters-test.csv",  header=None)
        x_tr = np.array([fix_image(r) for r in tr.iloc[:,1:].values]).astype("float32")/255
        x_te = np.array([fix_image(r) for r in te.iloc[:,1:].values]).astype("float32")/255
        y_tr = to_categorical(tr.iloc[:,0].values-1, 26)
        y_te = to_categorical(te.iloc[:,0].values-1, 26)
    with st.spinner("🚀 Đang train model..."):
        m = Sequential([
            Dense(1024, activation="relu", input_shape=(784,)),
            BatchNormalization(), Dropout(0.3),
            Dense(512,  activation="relu"), BatchNormalization(), Dropout(0.3),
            Dense(256,  activation="relu"), BatchNormalization(), Dropout(0.3),
            Dense(128,  activation="relu"), Dropout(0.2),
            Dense(26,   activation="softmax"),
        ])
        m.compile(optimizer="adam", loss="categorical_crossentropy", metrics=["accuracy"])
        m.fit(x_tr, y_tr, epochs=20, batch_size=128, validation_split=0.1,
              callbacks=[EarlyStopping(patience=3, restore_best_weights=True),
                         ReduceLROnPlateau(factor=0.5, patience=2)], verbose=0)
        _, acc = m.evaluate(x_te, y_te, verbose=0)
        m.save(MODEL_PATH)
    st.success(f"✅ Đã lưu model — Accuracy: {acc*100:.2f}%")
    return m

@st.cache_resource
def load_or_train():
    from keras.models import load_model
    if MODEL_PATH.exists():
        return load_model(MODEL_PATH)
    return train_and_save()

model = load_or_train()

def predict_array(arr: np.ndarray):
    resized  = cv2.resize(arr, (28, 28))
    inverted = cv2.bitwise_not(resized)
    inp      = inverted.reshape(1, 784).astype("float32") / 255.0
    preds    = model.predict(inp, verbose=0)[0]
    top5     = [(LABELS[i], float(preds[i])*100) for i in np.argsort(preds)[::-1][:5]]
    return top5

